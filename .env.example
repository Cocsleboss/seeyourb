# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secret, jamais côté client

# ---- URL publique de l'app (sans slash final) ----
NEXT_PUBLIC_APP_URL=https://seeyourb.vercel.app

# ---- Web Push (générer avec: npm run vapid) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.com

# ---- Secret partagé entre le cron (pg_cron / cron-job.org / Vercel Cron) et /api/cron/tick ----
# Générer avec: openssl rand -hex 32
CRON_SECRET=

# ---- Email (optionnel : canal de secours si pas de push). Un seul des deux suffit. ----
# Option A : Brevo (gratuit, 300 mails/jour, expéditeur = votre email vérifié) → https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Option B : Resend (gratuit, mais un domaine vérifié est requis pour écrire à d'autres personnes)
RESEND_API_KEY=
# Expéditeur utilisé (doit être vérifié chez le fournisseur choisi)
EMAIL_FROM="SeeYourB <vous@exemple.com>"
